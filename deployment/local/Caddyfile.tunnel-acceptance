# Public sign-in acceptance only; private workspaces remain closed.
# Named tunnel origin: http://127.0.0.1:8081, httpHostHeader: investify.fyi.
# Cloudflare terminates public TLS. Do not describe this as opaque TLS relay.
{
	admin off
	auto_https off
	import logging.caddy
}
import routes.caddy

http://investify.fyi:8081 {
	bind 127.0.0.1
	@auth_acceptance path /api/health /api/auth/config /api/auth/login /api/auth/callback /api/auth/me /api/auth/logout
	route {
		handle @auth_acceptance {
			header Cache-Control "no-store"
			header Referrer-Policy "no-referrer"
			header X-Content-Type-Options "nosniff"
			request_body {
				max_size 128KB
			}
			reverse_proxy 127.0.0.1:8000
		}
		@closed_api path /api /api/*
		handle @closed_api {
			header Cache-Control "no-store"
			header Content-Type "application/json"
			respond `{"detail":"Your account is ready. Private workspaces are still being verified."}` 503
		}
		import investify_routes
	}
}

http://:8081 {
	bind 127.0.0.1
	respond "Not found" 404
}
