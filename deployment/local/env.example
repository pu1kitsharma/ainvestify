# Copy to deployment/.env (already gitignored). Plain KEY=VALUE; no shell expansion.
# Never put secrets in frontend/VITE_* variables.
APP_ENV=production
APP_ORIGIN=https://investify.fyi
ALLOW_LOOPBACK_HTTP=0
LOCAL_DEV_PASSWORD_LOGIN=0
OIDC_ISSUER=https://accounts.google.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

PREPARATION_PROVIDER=local
OLLAMA_HOST=http://127.0.0.1:11434
LOCAL_OLLAMA_HOST=http://127.0.0.1:11434

# Explicit routes restored from the operator's archive; not quality approval.
# 9B/14B weights exceed 6 GB VRAM. CPU offload and latency need qualification.
SOURCING_MODEL=phi4-mini
REASONING_MODEL=qwen3:8b
REVIEW_MODEL=qwen3:14b
ESCALATION_MODEL=
PREPARATION_MODEL=qwen3.5:9b
LOCAL_MEMO_DRAFT_MODEL=qwen3.5:9b
LOCAL_MEMO_PART_B_MODEL=qwen3.5:9b
LOCAL_MEMO_AUTHOR_MODEL=qwen3:14b
LOCAL_MEMO_REVIEW_MODEL=qwen3:14b
LOCAL_MEMO_CHALLENGE_MODEL=qwen3.5:9b
LOCAL_MATERIAL_DRAFT_MODEL=qwen3.5:9b

# Configure only after restoring/qualifying the rights-reviewed local KB.
# ELASTICSEARCH_URL=https://127.0.0.1:9200
# ELASTICSEARCH_API_KEY_FILE=C:/path/outside/git/es-api-key
# ELASTICSEARCH_CA_FILE=C:/path/outside/git/http_ca.crt
# PRIVATE_ARTIFACT_ROOT=C:/path/to/approved/private/storage
# LIBREOFFICE_BINARY=C:/Program Files/LibreOffice/program/soffice.exe
# INVESTIFY_WEB_ROOT=C:/Users/gaura/Dev/ainvestify/frontend/dist
# CADDY_BINARY=C:/path/to/caddy.exe
# RESEARCH_AGENT_CONTACT=YourOrg contact@example.com