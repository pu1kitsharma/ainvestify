      "research.business": {
        "document": "research",
        "title": "Business and customer",
        "status": "complete",
        "content": {
          "text": "According to the Paasa website, the company provides a mobile service for affluent Indian customers seeking to invest in global equities. The company reports that it addresses customer problems such as remittance friction, unfamiliar tax requirements, complex paperwork, and a lack of investment guidance. Paasa describes itself as a financial technology firm that utilizes licensed partners, including Interactive Brokers for custody and Arc Spire Advisory for advisory services.",
          "fact_ids": [
            "fact_003c595b37e8",
            "fact_ec6bdd930a5d",
            "fact_8eb889c4e9a7"
          ]
        },
