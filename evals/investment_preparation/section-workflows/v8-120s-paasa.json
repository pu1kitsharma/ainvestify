      "research.economics": {
        "document": "research",
        "title": "Revenue mechanism",
        "status": "complete",
        "content": {
          "revenue_mechanism": "For the Access plan, customers pay brokerage fees when they trade, but the source does not state how much revenue Paasa retains from these charges. For the Apex plan, a percentage charge based on assets under management is collected monthly, and brokerage fees apply separately.",
          "unknown_economics": "It is unknown whether Paasa earns revenue from the Access plan's customer charges or if it acts solely as a pass-through to partners. Records showing how much of the customer charge is retained by Paasa versus passed to partners are needed to answer this.",
          "fact_ids": [
            "fact_4ec558c9fcc1",
            "fact_514c11e88803"
          ]
        },
