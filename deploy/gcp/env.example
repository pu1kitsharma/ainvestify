# Copy to env.sh and fill in. Never commit secrets.
export PROJECT_ID=""                 # new training-only GCP project
export BILLING_ACCOUNT=""            # e.g. 0X0X0X-0X0X0X-0X0X0X
export REGION="asia-south1"          # Mumbai
export ZONE="asia-south1-c"          # verify an A100 80GB (a2-ultragpu-1g) zone with capacity; may differ
export GPU_INSTANCE="agentic-banker-gpu"
export MACHINE_TYPE="a2-ultragpu-1g" # A100 80GB x1. Fallback a2-highgpu-1g = A100 40GB
export BUCKET="${PROJECT_ID}-banker-private"
export WEIGHTS_DISK="banker-weights"
export WEIGHTS_DISK_GB="200"
export BASE_MODEL="Qwen/Qwen3-32B"   # decided by the bake-off, not here
export MONTHLY_BUDGET_INR="22000"    # budget currency must match the billing account currency
export BUDGET_CURRENCY="INR"
export NETWORK="banker-vpc"
export SUBNET="banker-gpu-subnet"
export SUBNET_RANGE="10.20.0.0/24"
export TOKEN_SECRET="banker-vllm-token"
