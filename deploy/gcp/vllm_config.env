# Read by startup-script.sh (instance metadata `vllm-config`). Edit per run; no secrets here.
VLLM_VERSION=0.10.2
MODEL=/mnt/weights/base            # base weights on the persistent disk (copied from GCS once)
SERVED_MODEL_NAME=banker-base
MAX_MODEL_LEN=32768
GPU_MEMORY_UTILIZATION=0.90
PORT=8000
TOOL_CALL_PARSER=hermes           # unverified flag value; confirm with `vllm serve --help` before first run
# LoRA role adapters (served alongside the base; request model=<role name>).
ENABLE_LORA=1
MAX_LORAS=4
MAX_LORA_RANK=64
# name=path pairs on the weights disk, space separated. Adapters are copied from gs://BUCKET/adapters/.
LORA_MODULES="qc_associate=/mnt/weights/adapters/qc_associate md_reviewer=/mnt/weights/adapters/md_reviewer analyst=/mnt/weights/adapters/analyst"
